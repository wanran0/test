# 复制为 .env 后按需修改
PORT=3000
DB_PATH=./data/app.db
AUTH_SECRET=change-me-in-prod
# 微信小程序正式登录需 AppID/AppSecret 换 openid；骨架阶段用 mock
WX_APPID=
WX_APPSECRET=

# 开发组管理员登录 code（逗号分隔）。命中者自动获得 is_admin，可处理反馈与查看测评汇总
ADMIN_CODES=dev-zou,dev-zhang,dev-sun

# AI 月报：留空则使用离线占位实现（模板拼接，无需网络/密钥）
# 填上后可切任意 OpenAI 兼容接口（DeepSeek / 通义 / OpenAI 等）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

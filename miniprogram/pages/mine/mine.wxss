.hero { border-radius: 32rpx; padding: 36rpx 34rpx; margin-bottom: 24rpx; color: #FDFBF4; background: linear-gradient(135deg, #0F3D33, #17604C 70%, #257A57); box-shadow: 0 16rpx 36rpx rgba(15,61,51,.28); }
.avatar.big { width: 110rpx; height: 110rpx; border-radius: 32rpx; font-size: 44rpx; margin-right: 24rpx; }
.h-name { font-size: 40rpx; font-weight: 800; }
.h-sub { font-size: 24rpx; opacity: .8; }
.h-row { display: flex; border-top: 1rpx solid rgba(253,251,244,.2); margin-top: 26rpx; padding-top: 20rpx; }
.h-cell { flex: 1; text-align: center; }
.h-cell .v { font-size: 36rpx; font-weight: 800; }
.h-cell .k { font-size: 20rpx; opacity: .7; }
.idrow { display: flex; align-items: center; padding: 20rpx 6rpx; border-bottom: 1rpx dashed var(--line); border-radius: 16rpx; }
.idrow:last-child { border-bottom: none; }
.idrow.cur { background: var(--jade-soft); }
.idrow.hov { background: #F4EFE2; }
.idrow.locked { opacity: .5; }
.badge.lock { background: #F6E3DC; color: #D9482B; }
.brandlogo { display: block; width: 96rpx; height: 96rpx; margin: 26rpx auto 0; border-radius: 24rpx; }
.go { color: var(--pine2); font-weight: 700; font-size: 30rpx; }
.lrow.press:active { opacity: .7; }
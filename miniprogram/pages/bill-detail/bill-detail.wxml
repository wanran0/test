<nav-bar title="账单详情" sub="{{cat ? cat.name : ''}}"></nav-bar>
<view class="page">
  <view class="wrap">
    <view wx:if="{{gone}}" class="empty"><view class="ico"></view><view class="txt">账单已删除</view></view>
    <block wx:else>
      <view class="hero">
        <view class="row">
          <view class="badge {{b.settled ? 'ok' : 'warn'}}" style="background:rgba(253,251,244,.16);color:#FDFBF4">{{b.settled ? '已结清' : '待结清'}}</view>
          <view class="badge mute" style="margin-left:12rpx;background:rgba(253,251,244,.16);color:#FDFBF4">{{modeCN}}</view>
        </view>
        <view class="h-num num">¥{{amount}}</view>
        <view class="h-title">{{b.title}}</view>
        <view class="h-sub">{{dateCN}} · {{payer.name}} 垫付 · {{createdAgo}}登记</view>
      </view>

      <view class="card">
        <view class="card-title"><view class="t">分摊明细</view><view class="more">整数分 · 最大余额法</view></view>
        <view wx:for="{{rows}}" wx:key="id" class="prow">
          <view class="avatar" style="background:{{item.hue}}">{{item.name[0]}}</view>
          <view class="grow">
            <view class="between">
              <view class="row"><text class="bold">{{item.name}}</text><text wx:if="{{item.isPayer}}" class="badge head" style="margin-left:12rpx">垫付人</text></view>
              <text class="num bold">¥{{item.str}}</text>
            </view>
            <view class="bar-track" style="margin-top:10rpx"><view class="bar-fill" style="width:{{item.pct}}%;background:{{item.hue}}"></view></view>
          </view>
          <text class="pct num">{{item.pct}}%</text>
        </view>
      </view>

      <view wx:if="{{b.note}}" class="card">
        <view class="card-title"><view class="t">备注</view></view>
        <view class="sub" style="font-size:26rpx">{{b.note}}</view>
      </view>

      <button wx:if="{{canDelete}}" class="btn line block" style="color:var(--verm);border-color:var(--verm)" bindtap="onDelete">删除此账单</button>
      <view wx:else class="sub" style="text-align:center;margin:20rpx 0">仅垫付人 / 寝室长 / 管理员可删除</view>
    </block>
  </view>
  <snack id="snack"></snack>
</view>
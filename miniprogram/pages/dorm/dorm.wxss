.hero { border-radius: 32rpx; padding: 36rpx 34rpx; margin-bottom: 24rpx; color: #FDFBF4; background: linear-gradient(135deg, #0F3D33, #17604C 70%, #257A57); box-shadow: 0 16rpx 36rpx rgba(15,61,51,.28); }
.h-lab { font-size: 24rpx; opacity: .8; }
.h-title { font-size: 44rpx; font-weight: 800; }
.code { font-size: 48rpx; font-weight: 800; letter-spacing: 6rpx; color: #F4C877; }
.rm { margin-left: 18rpx; color: var(--verm); font-size: 24rpx; font-weight: 700; padding: 8rpx 18rpx; border: 2rpx solid var(--verm); border-radius: 999rpx; }
.rule { display: flex; padding: 12rpx 0; font-size: 26rpx; }
.rn { width: 40rpx; height: 40rpx; flex: none; border-radius: 12rpx; background: var(--amber-soft); color: #A96F14; font-weight: 800; font-size: 22rpx; display: flex; align-items: center; justify-content: center; margin-right: 16rpx; }
.exit { font-size: 22rpx; font-weight: 700; padding: 8rpx 20rpx; border-radius: 999rpx; background: rgba(253,251,244,.16); border: 1rpx solid rgba(253,251,244,.35); }
.tabs { display: flex; background: var(--card); border: 1rpx solid var(--line); border-radius: 999rpx; padding: 6rpx; margin-bottom: 24rpx; }
.tabs .t { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 999rpx; font-size: 25rpx; color: var(--mut); font-weight: 700; }
.tabs .t.on { background: var(--pine); color: #FDFBF4; }
.tiles { display: flex; flex-wrap: wrap; margin: 0 -8rpx 16rpx; }
.tile { width: calc(50% - 16rpx); margin: 8rpx; border-radius: 24rpx; padding: 26rpx; color: #FDFBF4; box-sizing: border-box; }
.tile .v { font-size: 52rpx; font-weight: 800; }
.tile .k { font-size: 22rpx; opacity: .85; }
.t1 { background: linear-gradient(135deg, #17604C, #0F3D33); }
.t2 { background: linear-gradient(135deg, #2E77AE, #1D5680); }
.t3 { background: linear-gradient(135deg, #E8A33D, #C77F16); }
.t4 { background: linear-gradient(135deg, #D9482B, #A93318); }
.h-num { font-size: 64rpx; font-weight: 800; color: var(--pine); }
.flagtext { margin-top: 14rpx; background: #F4EFE2; border-radius: 16rpx; padding: 16rpx 20rpx; font-size: 25rpx; color: var(--mut); }
.trow { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx dashed var(--line); }
.trow:last-of-type { border-bottom: none; }
.who { display: flex; align-items: center; width: 200rpx; }
.who.r { justify-content: flex-end; }
.arrow { flex: 1; text-align: center; padding: 0 10rpx; }
.aline { height: 4rpx; margin-top: 8rpx; border-radius: 4rpx; background: linear-gradient(90deg, var(--verm), var(--amber)); position: relative; }
.aline::after { content: ""; position: absolute; right: -2rpx; top: -6rpx; border: 8rpx solid transparent; border-left-color: var(--amber); }
<nav-bar title="净额结算" sub="{{dorm ? dorm.name : ''}}"></nav-bar>
<view class="page">
  <view class="wrap">
    <view class="card">
      <view class="card-title"><view class="t">成员净额</view><view class="more">应收 − 应付</view></view>
      <view wx:for="{{rows}}" wx:key="id" class="lrow">
        <view class="avatar" style="background:{{item.hue}}">{{item.name[0]}}</view>
        <view class="grow bold">{{item.name}}</view>
        <view class="num bold {{item.cls}}" style="font-size:32rpx">{{item.dir === '结清' ? '¥0.00' : (item.dir === '应付' ? '-' : '+') + '¥' + item.str}}</view>
        <text class="badge {{item.cls === 'jade' ? 'ok' : item.cls === 'verm' ? 'warn' : 'mute'}}" style="margin-left:14rpx">{{item.dir}}</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title"><view class="t">转账建议</view><view class="more">贪心匹配 · 笔数最少</view></view>
      <view wx:if="{{isEmpty}}" class="empty" style="padding:30rpx 0"><view class="txt jade bold">所有差额已结清，无需转账 🎉</view></view>
      <view wx:for="{{transfers}}" wx:key="index" class="trow">
        <view class="who">
          <view class="avatar" style="background:{{item.fromHue}};width:64rpx;height:64rpx;border-radius:20rpx;font-size:24rpx">{{item.from[0]}}</view>
          <text class="bold">{{item.from}}</text>
        </view>
        <view class="arrow">
          <view class="num bold verm">¥{{item.str}}</view>
          <view class="aline"></view>
        </view>
        <view class="who r">
          <text class="bold">{{item.to}}</text>
          <view class="avatar" style="background:{{item.toHue}};width:64rpx;height:64rpx;border-radius:20rpx;font-size:24rpx;margin:0 0 0 16rpx">{{item.to[0]}}</view>
        </view>
      </view>
      <button wx:if="{{!isEmpty}}" class="btn block" style="margin-top:20rpx" bindtap="onSettle" disabled="{{!isHead}}">标记全部结清</button>
      <view wx:if="{{!isEmpty && !isHead}}" class="sub" style="text-align:center;margin-top:14rpx">仅寝室长可确认结清（当前身份：{{roleCN}}）</view>
    </view>

    <view wx:if="{{history.length}}" class="card">
      <view class="card-title"><view class="t">结算历史</view></view>
      <view wx:for="{{history}}" wx:key="id" class="lrow">
        <view class="grow">
          <view class="bold">{{item.n}} 笔转账 · ¥{{item.sum}}</view>
          <view class="sub ellipsis">{{item.detail}}</view>
        </view>
        <text class="sub">{{item.ago}}</text>
      </view>
    </view>
  </view>
</view>
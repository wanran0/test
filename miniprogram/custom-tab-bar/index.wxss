.tb {
  display: flex; background: #FFFCF5; border-top: 1rpx solid #E6DCC6;
  padding: 12rpx 12rpx calc(12rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(15, 61, 51, .06);
}
.item { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 6rpx 0 2rpx; }
.item.hov { opacity: .8; }
.pill { padding: 6rpx 34rpx; border-radius: 999rpx; transition: background .2s ease; }
.item.on .pill { background: #E4EFE7; }
.ico { width: 44rpx; height: 44rpx; background-position: center; background-size: contain; background-repeat: no-repeat; }
.txt { font-size: 20rpx; color: #7C8781; margin-top: 2rpx; }
.item.on .txt { color: #0F3D33; font-weight: 800; }
